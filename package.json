{
  "name": "ngx-fluent-form",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "docs": "nx serve docs",
    "build": "nx run-many --target=build,build:schematics",
    "test": "nx run-many --target=test",
    "test:watch": "nx run-many --target=test --coverage --watch",
    "test:coverage": "nx run-many --target=test --coverage",
    "lint": "nx run-many --target=lint",
    "affected": "nx affected -t lint test build build:schematics",
    "release": "export npm_config_legacy_peer_deps=false && nx release",
    "prepare": "husky"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-server": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/ssr": "^21.0.0",
    "express": "~4.22.2",
    "ng-zorro-antd": "21.3.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-tsconfig-paths": "^6.1.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "~0.2100.0",
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular-devkit/core": "^21.0.0",
    "@angular-devkit/schematics": "^21.0.0",
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "@ngify/core": "^2.0.0",
    "@nx/angular": "23.2.0",
    "@nx/eslint": "23.2.0",
    "@nx/eslint-plugin": "23.2.0",
    "@nx/js": "23.2.0",
    "@nx/vite": "23.2.0",
    "@nx/vitest": "23.2.0",
    "@schematics/angular": "^21.0.0",
    "@stylistic/eslint-plugin": "^4.0.0",
    "@swc/helpers": "~0.5.18",
    "@types/express": "^4.17.14",
    "@types/node": "^20.0.0",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/ui": "^4.0.0",
    "angular-eslint": "^21.4.0",
    "autoprefixer": "^10.4.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.0.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.0.2",
    "jsdom": "^26.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "less": "^4.2.0",
    "lint-staged": "^15.0.0",
    "ng-packagr": "21.2.7",
    "nx": "23.2.0",
    "postcss": "^8.4.5",
