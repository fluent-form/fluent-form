{
  "name": "ui-zorro",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ui-zorro/src",
  "prefix": "lib",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": [
        "{workspaceRoot}/dist/ui-zorro"
      ],
      "options": {
        "project": "packages/ui-zorro/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/ui-zorro/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "packages/ui-zorro/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "outputs": [
        "{workspaceRoot}/coverage/ui-zorro"
      ],
      "options": {
        "watch": false,
        "coverage": true,
        "coverageInclude": [
          "packages/ui-zorro/src/**/*"
        ],
        "tsConfig": "packages/ui-zorro/tsconfig.spec.json",
        "runner": "vitest"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
